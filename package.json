{
  "name": "rift-diff",
  "version": "0.0.0",
  "description": "A zero-dependency, TypeScript-first diff engine built around ranges and predictable resource limits.",
  "keywords": [
    "diff",
    "edit-distance",
    "myers",
    "text",
    "typescript"
  ],
  "homepage": "https://github.com/frndchagas/rift-diff#readme",
  "bugs": {
    "url": "https://github.com/frndchagas/rift-diff/issues"
  },
  "license": "MIT",
  "author": "Fernando Chagas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frndchagas/rift-diff.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "scripts": {
    "build": "bun run clean && bun run build:types && bun run build:esm && bun run build:cjs && bun run test:package",
    "build:cjs": "bun build ./build/entry.ts --outdir ./dist/cjs --target node --format cjs --minify --sourcemap=external --entry-naming='index.cjs'",
    "build:esm": "bun build ./build/entry.ts --outdir ./dist/esm --target node --format esm --minify --sourcemap=external --entry-naming='index.js'",
    "build:types": "tsc -p tsconfig.build.json",
    "clean": "rm -rf ./dist",
    "test": "vitest run",
    "test:package": "node ./scripts/smoke-esm.mjs && node ./scripts/smoke-cjs.cjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "validate": "bun run lint && bun run typecheck && bun run test && bun run format:check",
    "bench": "bun run bench:bun",
    "bench:bun": "bun run ./bench/benchmark.ts",
    "bench:memory:bun": "bun run ./bench/memory-stress.ts",
    "bench:memory:node": "bun build ./bench/memory-stress.ts --outfile ./.bench/memory-stress.mjs --target node --format esm && node ./.bench/memory-stress.mjs",
    "bench:node": "bun build ./bench/benchmark.ts --outfile ./.bench/benchmark.mjs --target node --format esm && node ./.bench/benchmark.mjs",
    "prepublishOnly": "bun run validate && bun run build",
    "test:extended": "RIFT_TEST_EXTENDED=1 vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "diff": "^9.0.0",
    "fast-check": "^4.9.0",
    "fast-diff": "^1.3.0",
    "fast-myers-diff": "^3.2.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=22"
  },
  "packageManager": "bun@1.3.14"
}
